generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model PricingSettings {
  id                 String   @id @default("singleton")
  basePriceFcfa      Int      @default(5000)
  pricePerAgentFcfa  Int      @default(3000)
  pricePerClientFcfa Int      @default(100)
  updatedAt          DateTime @updatedAt

  @@map("pricing_settings")
}

model IntakeFormResponse {
  id             String    @id @default(uuid())
  clientId       String    @unique
  client         User      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  country        String?
  status         String    @default("DRAFT")
  answers        Json      @default("{}")
  currentSection String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  submittedAt    DateTime?

  @@map("intake_form_responses")
}

model Agency {
  id                   String                @id @default(uuid())
  name                 String
  email                String?
  phone                String?
  address              String?
  status               AgencyStatus          @default(ACTIVE)
  isInternal           Boolean               @default(false)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  applications         Application[]
  auditLogs            AuditLog[]
  applicationTemplates ApplicationTemplate[]
  subscription         Subscription?
  users                User[]

  @@map("agency")
}

model Plan {
  id                   String         @id @default(uuid())
  name                 String
  slug                 String         @unique
  priceFcfa            Int
  maxAgents            Int?
  maxClients           Int?
  maxWorkflows         Int?
  isPublic             Boolean        @default(true)
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  targetPlanPayments   Payment[]      @relation("TargetPlanPayments")
  pendingSubscriptions Subscription[] @relation("PendingPlanSubscriptions")
  subscriptions        Subscription[] @relation("PlanSubscriptions")

  @@map("plan")
}

model Subscription {
  id               String             @id @default(uuid())
  agencyId         String             @unique
  planId           String
  pendingPlanId    String?
  status           SubscriptionStatus @default(ACTIVE)
  autoRenew        Boolean            @default(true)
  currentPeriodEnd DateTime
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  payments         Payment[]
  agency           Agency             @relation(fields: [agencyId], references: [id])
  pendingPlan      Plan?              @relation("PendingPlanSubscriptions", fields: [pendingPlanId], references: [id])
  plan             Plan               @relation("PlanSubscriptions", fields: [planId], references: [id])

  @@map("subscription")
}

model Payment {
  id                   String         @id @default(uuid())
  subscriptionId       String
  amountFcfa           Int
  method               PaymentMethod?
  status               PaymentStatus  @default(PENDING)
  reference            String?        @unique
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  targetPlanId         String?
  gatewayTransactionId String?        @unique
  subscription         Subscription   @relation(fields: [subscriptionId], references: [id])
  targetPlan           Plan?          @relation("TargetPlanPayments", fields: [targetPlanId], references: [id])

  @@index([subscriptionId])
  @@map("payment")
}

model User {
  id                 String            @id @default(uuid())
  name               String
  email              String            @unique
  emailVerified      Boolean           @default(false)
  image              String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  agentId            String?
  password           String?
  isSuspended        Boolean           @default(false)
  address            String?
  dateOfBirth        DateTime?
  maritalStatus      MaritalStatus?
  nationality        String?
  numberOfChildren   Int               @default(0)
  phoneNumber        String?
  profession         String?
  profileCompleted   Boolean           @default(false)
  role               Role              @default(CLIENT)
  status             UserStatus        @default(ACTIVE)
  agencyId           String?
  mustChangePassword Boolean           @default(false)
  assignedApps       Application[]     @relation("AgentApplications")
  applications       Application[]     @relation("ClientApplications")
  authoredLogs       AuditLog[]        @relation("AuthorLogs")
  documents          Document[]
  intakeFormResponse IntakeFormResponse?
  messages           Message[]
  receivedMessages   OfficialMessage[] @relation("ReceivedMessages")
  sentMessages       OfficialMessage[] @relation("SentMessages")
  accounts           Account[]
  sessions           Session[]
  agency             Agency?           @relation(fields: [agencyId], references: [id])
  agent              User?             @relation("AgentClients", fields: [agentId], references: [id])
  assignedClients    User[]            @relation("AgentClients")

  @@index([agencyId])
  @@index([agentId])
  @@map("user")
}

model Session {
  id        String   @id @default(uuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id @default(uuid())
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id @default(uuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Application {
  id                    String               @id @default(uuid())
  country               String
  status                ApplicationStatus    @default(PENDING)
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  clientId              String
  agentId               String?
  type                  ApplicationType      @default(PR)
  agencyId              String?
  applicationTemplateId String?
  agency                Agency?              @relation(fields: [agencyId], references: [id])
  agent                 User?                @relation("AgentApplications", fields: [agentId], references: [id])
  template              ApplicationTemplate? @relation(fields: [applicationTemplateId], references: [id])
  client                User                 @relation("ClientApplications", fields: [clientId], references: [id])
  steps                 ApplicationStep[]

  @@index([agencyId])
  @@index([clientId])
  @@index([agentId])
}

model Message {
  id          String          @id @default(uuid())
  content     String
  createdAt   DateTime        @default(now())
  procedureId String
  senderId    String
  Procedure   ApplicationStep @relation(fields: [procedureId], references: [id])
  sender      User            @relation(fields: [senderId], references: [id])

  @@index([procedureId])
}

model OfficialMessage {
  id         String   @id @default(uuid())
  subject    String
  content    String
  senderId   String
  receiverId String
  createdAt  DateTime @default(now())
  receiver   User     @relation("ReceivedMessages", fields: [receiverId], references: [id])
  sender     User     @relation("SentMessages", fields: [senderId], references: [id])

  @@index([receiverId])
  @@index([senderId])
}

model Document {
  id          String         @id @default(uuid())
  name        String
  fileUrl     String
  storageKey  String?
  status      DocumentStatus @default(UPLOADED)
  uploadedAt  DateTime       @default(now())
  procedureId String
  uploaderId  String
  type        DocumentType   @default(OTHER)

  Procedure ApplicationStep @relation(fields: [procedureId], references: [id])
  uploader  User            @relation(fields: [uploaderId], references: [id])

  @@index([procedureId])
}

model AuditLog {
  id        String   @id @default(uuid())
  action    String
  details   String?
  userId    String?
  createdAt DateTime @default(now())
  logNumber Int      @unique @default(autoincrement())
  targetId  String?
  agencyId  String?
  agency    Agency?  @relation(fields: [agencyId], references: [id])
  author    User?    @relation("AuthorLogs", fields: [userId], references: [id])

  @@index([agencyId])
  @@index([userId])
}

model ApplicationStep {
  id                String               @id @default(uuid())
  description       String?
  status            ProcedureStatus      @default(PENDING)
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  applicationId     String
  isLocked          Boolean              @default(false)
  type              ProcedureType?
  label             String?
  order             Int                  @default(0)
  requiredDocuments String[]             @default([])
  Document          Document[]
  Message           Message[]
  application       Application          @relation(fields: [applicationId], references: [id])
  subSteps          ApplicationSubStep[]

  @@index([applicationId])
  @@map("Procedure")
}

model ApplicationSubStep {
  id                String          @id @default(uuid())
  applicationStepId String
  label             String
  description       String?
  order             Int
  status            ProcedureStatus @default(PENDING)
  isCompleted       Boolean         @default(false)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  referenceFileName String?
  referenceFileUrl  String?
  applicationStep   ApplicationStep @relation(fields: [applicationStepId], references: [id], onDelete: Cascade)

  @@index([applicationStepId])
  @@map("application_sub_step")
}

model ApplicationTemplate {
  id           String         @id @default(uuid())
  agencyId     String
  name         String
  description  String?
  isActive     Boolean        @default(true)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  applications Application[]
  agency       Agency         @relation(fields: [agencyId], references: [id])
  steps        StepTemplate[]

  @@index([agencyId])
  @@map("application_template")
}

model StepTemplate {
  id                    String              @id @default(uuid())
  type                  ProcedureType?
  label                 String?
  description           String?
  order                 Int
  isActive              Boolean             @default(true)
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  applicationTemplateId String
  referenceFileName     String?
  referenceFileUrl      String?
  requiredDocuments     String[]            @default([])
  applicationTemplate   ApplicationTemplate @relation(fields: [applicationTemplateId], references: [id], onDelete: Cascade)
  subSteps              SubStepTemplate[]

  @@index([applicationTemplateId])
  @@map("step_template")
}

model SubStepTemplate {
  id             String       @id @default(uuid())
  stepTemplateId String
  label          String
  description    String?
  order          Int
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  stepTemplate   StepTemplate @relation(fields: [stepTemplateId], references: [id], onDelete: Cascade)

  @@index([stepTemplateId])
  @@map("sub_step_template")
}

enum AgencyStatus {
  ACTIVE
  SUSPENDED
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
}

enum PaymentMethod {
  MTN_MOBILE_MONEY
  ORANGE_MONEY
  CARD
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
}

enum Role {
  ADMIN
  AGENT
  CLIENT
  SUPER_ADMIN
}

enum UserStatus {
  PENDING
  ACTIVE
  REJECTED
}

enum MaritalStatus {
  SINGLE
  MARRIED
  DIVORCED
  WIDOWED
}

enum DocumentType {
  PASSPORT
  PASSPORT_PHOTO
  BIRTH_CERTIFICATE
  ID_CARD
  DIPLOMA
  CV
  WORK_CERTIFICATE
  LANGUAGE_REGISTRATION
  LANGUAGE_RESULT
  MEDICAL
  VISA_APPROVAL
  OTHER
  TRANSCRIPT
  POLICE_CLEARANCE
}

enum DocumentStatus {
  UPLOADED
  VERIFIED
  REJECTED
}

enum ApplicationStatus {
  PENDING
  IN_REVIEW
  MODIFICATION_REQUESTED
  APPROVED
  REJECTED
  COMPLETED
  CANCELLED
  IN_PROGRESS
  SUBMITTED
  VALIDATED
}

enum ProcedureStatus {
  PENDING
  IN_PROGRESS
  APPROVED
  REJECTED
  ACTION_REQUIRED
}

enum ProcedureType {
  REGISTRATION
  CONTRACT_SIGNING
  FEE_PAYMENT
  DOCUMENT_COLLECTION
  DIPLOMA_EQUIVALENCE
  LANGUAGE_TEST_REGISTRATION
  LANGUAGE_TEST_RESULTS
  PROFILE_CREATION
  APPLICATION_SUBMISSION
  MEDICAL_EXAMINATION
  PASSPORT_SUBMISSION
}

enum ApplicationType {
  PR
  WORK
  STUDY
  SCHOLARSHIP
}
